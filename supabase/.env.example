# Copy to supabase/.env (gitignored). These back the env(...) references in
# config.toml's [auth.external.google] block, so they must be present in the
# environment when you start the local stack.
#
# Get them from Google Cloud Console → APIs & Services → Credentials →
# "OAuth 2.0 Client ID" (type: Web application). Add this Authorized redirect URI:
#   http://127.0.0.1:54321/auth/v1/callback
#
# Then load them before `make up`, e.g.:
#   set -a && source supabase/.env && set +a && make up
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
